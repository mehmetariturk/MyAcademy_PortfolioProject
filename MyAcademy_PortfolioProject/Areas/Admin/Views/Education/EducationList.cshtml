@model List<MyAcademy_PortfolioProject.Entities.Education>

@{
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<!-- Top bar: new button -->
<div class="d-flex justify-content-end mb-3">
    <a href="/Admin/Education/CreateEducation" class="btn-pastel-primary text-decoration-none">
        <i class="bi bi-plus-lg"></i> New Education
    </a>
</div>

<!-- List -->
<div class="content-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th style="width:40%">School</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="company-avatar"><i class="@item.IconUrl"></i></div>
                                <div>
                                    <div class="fw-semibold">@item.Title</div>
                                    <div class="small text-secondary">@item.Subtitle</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="fw-semibold">@item.StartDate.ToString("MM.yyyy") – @(item.EndDate?.ToString("MM.yyyy") ?? "Present")</div>
                            <div class="small text-secondary">@item.FocusAreas</div>
                        </td>
                        <td>@item.Location</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge-pastel badge-pastel-active">Active</span>
                            }
                            else
                            {
                                <span class="badge-pastel badge-pastel-completed">Passive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="/Admin/Education/UpdateEducation/@item.EducationId" class="btn-icon-action" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a href="/Admin/Education/DeleteEducation/@item.EducationId" class="btn-icon-action action-delete btn-delete" title="Delete">
                                <i class="bi bi-trash3"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>