@model MyAcademy_PortfolioProject.Entities.Education
@{
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="form-card">
    <form asp-area="Admin" asp-action="UpdateEducation" method="post">
        <input type="hidden" asp-for="EducationId" />

        <div class="form-card-header">
            <div class="form-card-icon"><i class="bi bi-mortarboard"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">Update Education</h5>
                <small class="text-secondary">Edit the education details and save your changes.</small>
            </div>
        </div>

        <div class="form-card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="Title" class="form-label">School <span class="req">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-building"></i>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Yildiz Technical University" required />
                    </div>
                    <span asp-validation-for="Title"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Subtitle" class="form-label">Degree / Department <span class="req">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-mortarboard"></i>
                        <input asp-for="Subtitle" class="form-control" placeholder="e.g. Computer Engineering — B.Sc." required />
                    </div>
                    <span asp-validation-for="Subtitle"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Location" class="form-label">Location</label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-geo-alt"></i>
                        <input asp-for="Location" class="form-control" placeholder="e.g. Istanbul, Türkiye" />
                    </div>
                    <span asp-validation-for="Location"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="FocusAreas" class="form-label">Focus Areas</label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-tags"></i>
                        <input asp-for="FocusAreas" class="form-control" placeholder="e.g. Algorithms, Database Systems" />
                    </div>
                    <small class="text-secondary">Separate with commas.</small>
                </div>

                <div class="col-md-6">
                    <label asp-for="StartDate" class="form-label">Start Date <span class="req">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-calendar3"></i>
                        <input asp-for="StartDate" type="date" class="form-control" required />
                    </div>
                    <span asp-validation-for="StartDate"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="EndDate" class="form-label">End Date</label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-calendar-check"></i>
                        <input asp-for="EndDate" type="date" class="form-control" />
                    </div>
                    <small class="text-secondary">Leave empty if you are still studying.</small>
                </div>

                <div class="col-md-6">
                    <label asp-for="IconUrl" class="form-label">Timeline Icon</label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-stars"></i>
                        <input asp-for="IconUrl" class="form-control" placeholder="e.g. bi bi-mortarboard" />
                    </div>
                    <small class="text-secondary">Bootstrap Icons class name.</small>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Visibility</label>
                    <div class="status-box">
                        <div>
                            <div class="fw-semibold" style="font-size: 0.86rem;">Active</div>
                            <small class="text-secondary">Show this education on the portfolio.</small>
                        </div>
                        <div class="form-check form-switch m-0">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4"
                              placeholder="Short summary of your studies..."></textarea>
                    <span asp-validation-for="Description"></span>
                </div>
            </div>
        </div>

        <div class="form-card-footer">
            <a asp-area="Admin" asp-action="EducationList" class="btn btn-soft">
                <i class="bi bi-arrow-left me-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-accent">
                <i class="bi bi-check2-circle me-1"></i> Save Changes
            </button>
        </div>
    </form>
</div>