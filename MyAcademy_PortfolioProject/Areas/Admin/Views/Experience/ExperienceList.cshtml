@model List<MyAcademy_PortfolioProject.Entities.Experience>
@{
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container">
    <br /><br />
    <table class="table table-bordered">
        <tr>
            <th>#</th>
            <th>Title</th>
            <th>Sub Title</th>
            <th>Date</th>
            <th>Status</th>
            <th>Delete</th>
            <th>Update</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ExperienceId</td>
                <td>@item.Title</td>
                <td>@item.SideTitle</td>
                <td>@item.Duration</td>
                <td>@item.IsActive</td>
                <td><a href="/Admin/Experience/DeleteExperience/@item.ExperienceId" class="btn btn-danger">Delete</a></td>
                <td><a href="/Admin/Experience/UpdateExperience/@item.ExperienceId" class="btn btn-success">Update</a></td>
            </tr>
        }
    </table>
</div>

