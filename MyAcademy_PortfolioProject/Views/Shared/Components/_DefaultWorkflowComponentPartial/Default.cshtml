@model List<Workflow>
<!-- Personal Workflow Section -->
<section id="workflow" style="background-color: var(--bg-secondary);">
    <div class="container">
        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">HOW I WORK</span>
            <h2 class="section-title">From Idea to Product</h2>
            <p class="section-subtitle">I start every project with a planned, sustainable and user-focused approach.</p>
        </div>

        <div class="row g-4 position-relative">
            <!-- Step -->
            @{
                var colors = new[] { "purple", "blue", "mint", "peach" };
                int i = 0;
            }
            @foreach (var item in Model)
            {
                var color = colors[i % colors.Length];

                <div class="col-lg-3 col-md-6 reveal-on-scroll">
                    <div class="workflow-step-card">
                        <div class="workflow-num">@item.StepOrder.ToString("D2")</div>
                        <div class="float-icon-box bg-icon-@color mb-3">
                            <i class="@item.IconUrl"></i>
                        </div>
                        <h4 class="fs-5 fw-bold mb-2">@item.Title</h4>
                        <p class="text-secondary small mb-0">@item.Description</p>
                        @if (i < Model.Count - 1)
                        {
                            <div class="workflow-arrow d-none d-lg-flex">
                                <i class="bi bi-arrow-right-short fs-5"></i>
                            </div>
                        }
                    </div>
                </div>
                i++;
            }
            
        </div>
    </div>
</section>