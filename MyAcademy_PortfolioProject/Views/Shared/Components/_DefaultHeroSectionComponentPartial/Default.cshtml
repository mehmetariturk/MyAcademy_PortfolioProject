@model MyAcademy_PortfolioProject.Models.ViewModels.HeroViewModel
@if (Model.Hero == null) { return; }

<!-- Hero Section -->
<section id="home">
    <div class="container">
        <div class="row align-items-center g-5">
            <!-- Left Content -->
            <div class="col-lg-7 reveal-on-scroll">
                <div class="hero-badge">
                    <span>👋</span> @Model.Hero.Title
                </div>

                <h1 class="hero-title">
                    Hi, I am <span class="hero-name-gradient">@Model.Hero.SubTitle</span>.
                </h1>

                <!-- Animated Typing Text Slider -->
                <div class="typing-container" aria-live="polite">
                    <span id="typedText"></span><span class="typing-cursor"></span>
                </div>

                <p class="hero-desc">
                    @Model.Hero.Description
                </p>

                <div class="d-flex flex-wrap gap-3 align-items-center mb-4">
                    <a href="#projects" class="btn-custom-primary">
                        <i class="bi bi-grid-fill"></i>
                        View My Projects
                    </a>
                    <a href="#contact" class="btn-custom-outline">
                        <i class="bi bi-chat-dots"></i>
                        Get In Touch
                    </a>
                </div>

                @if (Model.Contact != null)
                {
                    <div class="d-flex align-items-center gap-2 pt-2">
                        <span class="text-secondary small fw-medium me-2">Find me on:</span>
                        <a href="@Model.Contact.Github" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="GitHub">
                            <i class="bi bi-github"></i>
                        </a>
                        <a href="@Model.Contact.Linkedin" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="LinkedIn">
                            <i class="bi bi-linkedin"></i>
                        </a>
                        <a href="mailto:@Model.Contact.Email" class="social-btn" aria-label="Send Email">
                            <i class="bi bi-envelope"></i>
                        </a>
                    </div>
                }
            </div>

            <!-- Right Visual with Portrait & Floating Badges -->
            <div class="col-lg-5 reveal-on-scroll">
                <div class="hero-image-wrapper">
                    <!-- Floating badge top left -->
                    <div class="floating-card float-top-left">
                        <div class="float-icon-box bg-icon-purple">
                            <i class="bi bi-code-slash"></i>
                        </div>
                        <div>
                            <div class="fw-bold small text-dark">Clean Code</div>
                            <div class="text-secondary" style="font-size: 0.72rem;">C# & ASP.NET Core</div>
                        </div>
                    </div>

                    <!-- Main Portrait -->
                    <div class="hero-image-frame">
                        <img src="@Model.Hero.ImageUrl" alt="@Model.Hero.SubTitle" loading="lazy">
                    </div>

                    <!-- Floating badge bottom right -->
                    <div class="floating-card float-bottom-right">
                        <div class="float-icon-box bg-icon-mint">
                            <i class="bi bi-laptop"></i>
                        </div>
                        <div>
                            <div class="fw-bold small text-dark">Software Engineer</div>
                            <div class="text-secondary" style="font-size: 0.72rem;">Full Stack Developer</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>