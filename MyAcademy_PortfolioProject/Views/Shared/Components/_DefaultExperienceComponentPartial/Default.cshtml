@model List<MyAcademy_PortfolioProject.Entities.Experience>
<!-- Work Experience Section -->
<section id="experience">
    <div class="container">
        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">PROFESSIONAL JOURNEY</span>
            <h2 class="section-title">Experience</h2>
            <p class="section-subtitle">Experience gained while solving real-world problems.</p>
        </div>

        <div class="timeline-container">
            @{int i = 0; }
            @foreach (var item in Model)
            {
                var badge = item.WorkType switch
                {
                    "Full-time" => "success",
                    "Part-time" => "primary",
                    _ => "warning"
                };

                if (i % 2 == 0)
                {
                    <div class="timeline-item row align-items-center g-4 reveal-on-scroll">
                        <div class="col-lg-6 timeline-left order-2 order-lg-1">
                            <div class="timeline-content-card">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge-year bg-icon-purple">
                                        <i class="bi bi-briefcase"></i> @item.StartDate.Year - @(item.EndDate?.Year.ToString() ?? "Present")
                                    </span>
                                    <span class="badge bg-@badge-subtle text-@badge border border-@badge-subtle rounded-pill px-3 py-1 small">@item.WorkType</span>
                                </div>
                                <h4 class="fs-5 fw-bold mb-1">@item.Title</h4>
                                <div class="text-primary fw-semibold small mb-3">@item.CompanyName</div>
                                <ul class="text-secondary small ps-3 mb-3" style="line-height: 1.6;">
                                    
                                    @foreach (var line in item.Description.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <li>@line</li>
                                    }

                                </ul>
                                <div>
                                    
                                    @foreach (var tech in item.TechnicalSkills)
                                    {
                                        <span class="tech-tag">@tech.TechnicalSkillName</span>
                                    }

                                </div>
                            </div>
                        </div>
                        <div class="timeline-marker">
                            <i class="@item.IconUrl"></i>
                        </div>
                        <div class="col-lg-6 timeline-right order-1 order-lg-2 d-none d-lg-block">
                            <div class="text-secondary small fst-italic">@item.SideTitle</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="timeline-item row align-items-center g-4 reveal-on-scroll">
                        <div class="col-lg-6 timeline-left d-none d-lg-block">
                            <div class="text-secondary small fst-italic">@item.SideTitle</div>
                        </div>
                        <div class="timeline-marker">
                            <i class="@item.IconUrl"></i>
                        </div>
                        <div class="col-lg-6 timeline-right">
                            <div class="timeline-content-card">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge-year bg-icon-blue">
                                        <i class="bi bi-briefcase"></i> @item.StartDate.Year - @(item.EndDate?.Year.ToString() ?? "Present")
                                    </span>
                                    <span class="badge bg-@badge-subtle text-@badge border border-@badge-subtle rounded-pill px-3 py-1 small">@item.WorkType</span>
                                </div>
                                <h4 class="fs-5 fw-bold mb-1">@item.Title</h4>
                                <div class="text-primary fw-semibold small mb-3">@item.CompanyName</div>
                                <ul class="text-secondary small ps-3 mb-3" style="line-height: 1.6;">

                                    @foreach (var line in item.Description.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <li>@line</li>
                                    }

                                </ul>
                                <div>

                                    @foreach (var tech in item.TechnicalSkills)
                                    {
                                        <span class="tech-tag">@tech.TechnicalSkillName</span>
                                    }

                                </div>
                            </div>
                        </div>
                    </div>
                }
                i++;
            }
        </div>
    </div>
</section>