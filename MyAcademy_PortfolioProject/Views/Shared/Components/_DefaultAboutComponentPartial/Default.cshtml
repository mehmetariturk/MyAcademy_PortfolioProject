@model MyAcademy_PortfolioProject.Models.ViewModels.AboutViewModel
@if (Model.About == null)
{
    return;
}
<!-- About Me Section -->
<section id="about">
    <div class="container">
        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">GET TO KNOW ME</span>
            <h2 class="section-title">About Me</h2>
            <p class="section-subtitle">Turning my curiosity for technology into software that adds value to people.</p>
        </div>

        <div class="row g-5 align-items-center">
            <!-- Left: Personal Details Card -->
            <div class="col-lg-5 reveal-on-scroll">
                <div class="about-visual-box">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="float-icon-box bg-icon-purple" style="width: 52px; height: 52px; font-size: 1.4rem;">
                            <i class="bi bi-person-badge"></i>
                        </div>
                        <div>
                            <h4 class="mb-0 fs-5 fw-bold">@Model.About.NameSurname</h4>
                            <span class="text-secondary small">@Model.About.Jobtitle</span>
                        </div>
                    </div>

                    <div class="info-list">
                        <div class="info-list-item">
                            <span class="info-label"><i class="bi bi-person me-2"></i>Name Surname</span>
                            <span class="info-value">@Model.About.NameSurname</span>
                        </div>
                        <div class="info-list-item">
                            <span class="info-label"><i class="bi bi-briefcase me-2"></i>Role</span>
                            <span class="info-value">@Model.About.Jobtitle</span>
                        </div>
                        <div class="info-list-item">
                            <span class="info-label"><i class="bi bi-geo-alt me-2"></i>Location</span>
                            <span class="info-value">@Model.About.Location</span>
                        </div>
                        <div class="info-list-item">
                            <span class="info-label"><i class="bi bi-layers me-2"></i>Expertise</span>
                            <span class="info-value">@Model.About.Expert</span>
                        </div>
                        <div class="info-list-item">
                            <span class="info-label"><i class="bi bi-envelope me-2"></i>Email</span>
                            <span class="info-value">@Model.About.Email</span>
                        </div>
                    </div>

                    @if (Model.About.OpenToWork)
                    {
                        <div class="mt-4 pt-2">
                            <div class="p-3 rounded-4" style="background-color: var(--lavender-accent);">
                                <div class="d-flex align-items-center gap-2 text-dark small fw-semibold">
                                    <i class="bi bi-check-circle-fill text-success"></i> Open to new projects and collaborations
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Right: Biography & Highlight Cards -->
            <div class="col-lg-7 reveal-on-scroll">
                <div class="pe-lg-3">

                    @foreach (var p in (Model.About.Description ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <p class="fs-6 text-secondary mb-3">@p</p>
                    }
                    
                    <!-- Three Small Highlight Cards -->
                    <div class="row g-3">

                        @foreach (var item in Model.Highlights)
                        {
                            <div class="col-md-4">
                                <div class="highlight-card">
                                    <div class="float-icon-box bg-icon-purple mb-3">
                                        <i class="@item.IconUrl"></i>
                                    </div>
                                    <h5 class="fs-6 fw-bold mb-1">@item.Title</h5>
                                    <p class="text-secondary small mb-0">@item.Description</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>