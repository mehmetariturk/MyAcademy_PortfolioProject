@model List<Education>
<!-- Education Section -->
<section id="education" style="background-color: var(--bg-secondary);">
    <div class="container">
        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">ACADEMIC JOURNEY</span>
            <h2 class="section-title">Education</h2>
            <p class="section-subtitle">The academic foundations of my journey into software.</p>
        </div>

        <div class="timeline-container">

            @{
                int i = 0; 
            }

            @foreach (var item in Model)
            {
                if (i % 2 == 0)
                {
                    <!-- 1. University -->
                    <div class="timeline-item row align-items-center g-4 reveal-on-scroll">
                        <div class="col-lg-6 timeline-left order-2 order-lg-1">
                            <div class="timeline-content-card">
                                <span class="badge-year bg-icon-purple mb-2">
                                    <i class="bi bi-calendar3"></i> @item.StartDate.Year – @(item.EndDate?.Year.ToString() ?? "Present")
                                </span>
                                <h4 class="fs-5 fw-bold mb-1">@item.Title</h4>
                                <div class="text-primary fw-semibold small mb-2">@item.Subtitle</div>
                                <p class="text-secondary small mb-3">
                                    @item.Description
                                </p>
                                <div>

                                    @foreach (var focus in (item.FocusAreas ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                    {
                                        <span class="tech-tag">@focus</span>
                                    }

                                </div>
                            </div>
                        </div>
                        <div class="timeline-marker">
                            <i class="@item.IconUrl"></i>
                        </div>
                        <div class="col-lg-6 timeline-right order-1 order-lg-2 d-none d-lg-block">
                            <div class="text-secondary fst-italic small">@item.Location</div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- 2. High School -->
                    <div class="timeline-item row align-items-center g-4 reveal-on-scroll">
                        <div class="col-lg-6 timeline-left d-none d-lg-block">
                            <div class="text-secondary fst-italic small">@item.Location</div>
                        </div>
                        <div class="timeline-marker">
                            <i class="@item.IconUrl"></i>
                        </div>
                        <div class="col-lg-6 timeline-right">
                            <div class="timeline-content-card">
                                <span class="badge-year bg-icon-mint mb-2">
                                    <i class="bi bi-calendar3"></i> @item.StartDate.Year – @(item.EndDate?.Year.ToString() ?? "Present")
                                </span>
                                <h4 class="fs-5 fw-bold mb-1">@item.Title</h4>
                                <div class="text-primary fw-semibold small mb-2">@item.Subtitle</div>
                                <p class="text-secondary small mb-3">
                                    @item.Description
                                </p>
                                <div>

                                    @foreach (var focus in (item.FocusAreas ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                    {
                                        <span class="tech-tag">@focus</span>
                                    }
                             
                                </div>
                            </div>
                        </div>
                    </div>
                }
                i++;
            }
        </div>
    </div>
</section>