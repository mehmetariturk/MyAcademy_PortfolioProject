@model MyAcademy_PortfolioProject.Models.ViewModels.ProjectViewModel

<!-- Portfolio Projects Section -->
<section id="projects">
    <div class="container">
        <div class="text-center mb-4 reveal-on-scroll">
            <span class="section-eyebrow">SELECTED WORK</span>
            <h2 class="section-title">Projects</h2>
            <p class="section-subtitle">Projects where I turn what I learn into real products.</p>
        </div>

        <!-- Category Filter Buttons -->
        <div class="d-flex justify-content-center flex-wrap gap-2 mb-5 reveal-on-scroll" id="projectFilterGroup">
            <button class="filter-btn active" data-filter="all">All</button>
            @foreach (var cat in Model.Categories)
            {
                <button class="filter-btn" data-filter="cat-@cat.CategoryId">@cat.CategoryName</button>
            }
        </div>

        <!-- Project Cards Grid -->
        <div class="row g-4" id="projectGrid">
            @foreach (var item in Model.Projects)
            {
                <div class="col-lg-4 col-md-6 project-item" data-category="cat-@item.CategoryId">
                    <div class="project-card reveal-on-scroll">

                        <!-- Project Image -->
                        <div class="project-thumb" style="width:100%; aspect-ratio:16/9; overflow:hidden;">
                            <img src="@item.CoverImageUrl" alt="@item.Title"
                                 style="width:100%; height:100%; object-fit:cover; display:block;" />
                        </div>

                        <!-- Project Content -->
                        <div class="project-body">
                            <span class="project-category-badge">@item.Category.CategoryName</span>
                            <h3 class="project-title">@item.Title</h3>
                            <p class="project-desc">@item.Description</p>

                            <!-- Technologies -->
                            <div class="mb-3">
                                @foreach (var tech in item.TechnicalSkills)
                                {
                                    <span class="tech-tag">@tech.TechnicalSkillName</span>
                                }
                            </div>

                            <!-- Project Links -->
                            <div class="project-footer">
                                <a href="@item.GithubUrl" target="_blank" rel="noopener noreferrer" class="project-link-btn">
                                    <i class="bi bi-github"></i> GitHub
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>
</section>