@model List<Certification>
<!-- Certifications Section -->
<section id="certificates">
    <div class="container">
        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">CONTINUOUS LEARNING</span>
            <h2 class="section-title">Certifications</h2>
            <p class="section-subtitle">Courses I completed to improve my technical skills.</p>
        </div>

        <div class="row g-4">

            @{
                var colors = new[] { "purple", "blue", "mint", "peach" };
                int i = 0;
            }

            <!-- Cert 1 -->
            @foreach (var item in Model)
            {
                var color = colors[i % colors.Length];
                i++;
                <div class="col-lg-3 col-md-6 reveal-on-scroll">
                    <div class="certificate-card">
                        <div class="float-icon-box bg-icon-@color mb-3">
                            <i class="@item.IconUrl"></i>
                        </div>
                        <span class="badge bg-light text-secondary border rounded-pill px-2 py-1 mb-2 align-self-start small">@item.DateTime.Year</span>
                        <h4 class="fs-6 fw-bold mb-1">@item.Title</h4>
                        <div class="text-secondary small mb-3">@item.Description</div>
                        <div class="mt-auto">
                            @if (!string.IsNullOrEmpty(item.CertificateUrl))
                            {
                                <a href="@item.CertificateUrl" target="_blank" rel="noopener" class="project-link-btn text-primary">
                                    View Certificate <i class="bi bi-arrow-up-right"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
            
        </div>
    </div>
</section>