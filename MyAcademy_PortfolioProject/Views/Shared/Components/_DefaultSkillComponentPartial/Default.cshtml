@model List<MyAcademy_PortfolioProject.Entities.Skill>
<!-- Technical Skills Section -->
<section id="skills" style="background-color: var(--bg-secondary);">
    <div class="container">
        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">TECHNICAL SKILLS</span>
            <h2 class="section-title">My Skills</h2>
            <p class="section-subtitle">The technologies I use to turn ideas into working software.</p>
        </div>

        <div class="row g-4">
            @{
                int i = 0;
            }
            @foreach (var item in Model)
            {
                var col = i < 3 ? "col-lg-4 col-md-6" : "col-lg-6";
                i++;

                <div class="@col reveal-on-scroll">
                    <div class="skill-group-card">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="float-icon-box bg-icon-purple">
                                <i class="@item.IconUrl"></i>
                            </div>
                            <h4 class="fs-5 fw-bold mb-0">@item.SkillTitle</h4>
                        </div>
                        <p class="text-secondary small mb-3">@item.SkillDescription</p>
                        <div class="d-flex flex-wrap">
                            @foreach (var tech in item.TechnicalSkills)
                            {
                                <span class="skill-chip">
                                    <i class="bi bi-check text-success"></i> @tech.TechnicalSkillName
                                    <small class="text-secondary ms-1">%@tech.Percentage</small>
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>