@model Contact
@if (Model == null) { return; }
<!-- Contact Section -->
<section id="contact" style="background-color: var(--bg-secondary);">
    <div class="container">
        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">GET IN TOUCH</span>
            <h2 class="section-title">Let's Build Something Great Together.</h2>
            <p class="section-subtitle">Reach out for new projects, collaborations or just to say hello.</p>
        </div>

        <div class="row g-5">
            <!-- Left: Contact Details -->
            <div class="col-lg-5 reveal-on-scroll">
                <div class="contact-info-card">
                    <h4 class="fs-4 fw-bold mb-3">Contact Information</h4>
                    <p class="text-secondary mb-4">@Model.Description</p>

                    <div class="contact-item">
                        <div class="contact-icon bg-icon-purple">
                            <i class="bi bi-envelope"></i>
                        </div>
                        <div>
                            <div class="text-secondary small fw-medium">Email</div>
                            <a href="mailto:@Model.Email" class="text-decoration-none fw-bold text-dark">@Model.Email</a>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-icon bg-icon-blue">
                            <i class="bi bi-geo-alt"></i>
                        </div>
                        <div>
                            <div class="text-secondary small fw-medium">Location</div>
                            <div class="fw-bold text-dark">@Model.Location</div>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-icon bg-icon-mint">
                            <i class="bi bi-linkedin"></i>
                        </div>
                        <div>
                            <div class="text-secondary small fw-medium">LinkedIn</div>
                            <a href="@Model.Linkedin" target="_blank" rel="noopener" class="text-decoration-none fw-bold text-dark">
                                @((Model.Linkedin ?? "").Replace("https://", "").Replace("www.", ""))
                            </a>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-icon bg-icon-peach">
                            <i class="bi bi-github"></i>
                        </div>
                        <div>
                            <div class="text-secondary small fw-medium">GitHub</div>
                            <a href="@Model.Github" target="_blank" rel="noopener" class="text-decoration-none fw-bold text-dark">
                                @((Model.Github ?? "").Replace("https://", "").Replace("www.", ""))
                            </a>
                        </div>
                    </div>

                    <div class="mt-4 p-3 rounded-4 bg-white border border-light-subtle">
                        <div class="d-flex align-items-center gap-2 text-secondary small">
                            <i class="bi bi-clock-history text-primary"></i> I usually reply within 24 hours.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Contact Form -->
            <div class="col-lg-7 reveal-on-scroll">
                <div class="contact-form-card">
                    <form asp-controller="Default" asp-action="SendMessage" method="post">

                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success border-0 rounded-3 small py-2 px-3 mb-4" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                            </div>
                        }
                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger border-0 rounded-3 small py-2 px-3 mb-4" role="alert">
                                <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["Error"]
                            </div>
                        }

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="contactFullName" class="form-label">Full Name *</label>
                                <input type="text" class="form-control" id="contactFullName" name="NameSurname"
                                       placeholder="e.g. John Smith" maxlength="50" required>
                            </div>

                            <div class="col-md-6">
                                <label for="contactEmail" class="form-label">Email Address *</label>
                                <input type="email" class="form-control" id="contactEmail" name="Email"
                                       placeholder="e.g. john@example.com" required>
                            </div>

                            <div class="col-12">
                                <label for="contactSubject" class="form-label">Subject *</label>
                                <input type="text" class="form-control" id="contactSubject" name="Subject"
                                       placeholder="e.g. Project Collaboration" maxlength="100" required>
                            </div>

                            <div class="col-12">
                                <label for="contactMessage" class="form-label">Message *</label>
                                <textarea class="form-control" id="contactMessage" name="MessageDetail" rows="5"
                                          placeholder="Tell me about your project or idea..." minlength="10" maxlength="2000" required></textarea>
                            </div>

                            <div class="col-12 mt-4">
                                <button type="submit" class="btn-custom-primary w-100 justify-content-center py-3">
                                    <i class="bi bi-send-fill"></i> Send Message
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>