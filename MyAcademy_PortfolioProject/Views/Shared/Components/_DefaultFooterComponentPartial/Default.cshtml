@model Contact
<!-- Footer -->
<footer>
    <div class="container">
        <div class="row g-4 align-items-center mb-5">
            <!-- Col 1: Brand -->
            <div class="col-lg-4 text-center text-lg-start">
                <a class="navbar-brand d-inline-flex align-items-center mb-2" href="#home">
                    <span class="brand-mark">M</span>
                    <span class="brand-name">Mehmet<span>.</span></span>
                </a>
                <p class="text-secondary small mb-0">Built with technology, design and creativity.</p>
            </div>

            <!-- Col 2: Navigation Links -->
            <div class="col-lg-4 text-center">
                <ul class="list-inline mb-0">
                    <li class="list-inline-item mx-2"><a href="#home" class="footer-link">Home</a></li>
                    <li class="list-inline-item mx-2"><a href="#about" class="footer-link">About</a></li>
                    <li class="list-inline-item mx-2"><a href="#projects" class="footer-link">Projects</a></li>
                    <li class="list-inline-item mx-2"><a href="#contact" class="footer-link">Contacts</a></li>
                </ul>
            </div>

            <!-- Col 3: Social Links -->
            <div class="col-lg-4 text-center text-lg-end">
                <div class="d-inline-flex gap-2">
                    <a href="@Model.Github" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="GitHub">
                        <i class="bi bi-github"></i>
                    </a>
                    <a href="@Model.Linkedin" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="LinkedIn">
                        <i class="bi bi-linkedin"></i>
                    </a>
                </div>
            </div>
        </div>

        <hr class="text-secondary opacity-25 mb-4">

        <div class="text-center">
            <p class="text-secondary small mb-0">@DateTime.Now.Year Mehmet Arıtürk. All rights reserved.</p>
        </div>
    </div>
</footer>